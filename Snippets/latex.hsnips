global
function math(context) {
    if (!context.scopes) return false;
    // Targeting your exact VS Code scopes
    return context.scopes.some(s => 
        s.startsWith("meta.math") || 
        s.startsWith("support.class.math") || 
        s.includes("math.block")
    );
}
function text(context) {
    return !math(context);
}
endglobal

// =======================
// TEXT MODE SNIPPETS (Only trigger outside of equations)
// =======================
context text(context)
snippet mk "Inline Math" A
$$1$$0
endsnippet

context text(context)
snippet dm "Display Math" Aw
$$
$1
$$
$0
endsnippet

context text(context)
snippet mca "Mathcal A" A
$\mathcal{A}$$0
endsnippet

context text(context)
snippet mcb "Mathcal B" A
$\mathcal{B}$$0
endsnippet


