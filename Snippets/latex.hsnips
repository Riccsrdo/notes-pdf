// =======================
// REGEX MATH SNIPPETS
// =======================
context math(context)
snippet `([^\\])(alpha|beta|gamma|delta|epsilon|zeta|eta|theta|iota|kappa|lambda|mu|nu|xi|pi|rho|sigma|tau|upsilon|phi|chi|psi|omega|Gamma|Delta|Theta|Lambda|Xi|Pi|Sigma|Upsilon|Phi|Psi|Omega)` "Auto backslash Greek" A
``rv = m[1]``\``rv = m[2]``
endsnippet

context math(context)
snippet `\\(arcsin|arccos|arctan|arccot|arccsc|arcsec|sin|cos|tan|cot|csc)([A-Za-gi-z])` "Space after trig" A
\``rv = m[1]`` ``rv = m[2]``
endsnippet

context math(context)
snippet `([A-Za-z])(\d)` "Auto letter subscript" A
``rv = m[1]``_{``rv = m[2]``}
endsnippet

context math(context)
snippet `([A-Za-z])_(\d\d)` "Auto subscript double digit" A
``rv = m[1]``_{``rv = m[2]``}
endsnippet

context math(context)
snippet `([a-zA-Z])bar` "Auto bar" A
\bar{``rv = m[1]``}
endsnippet

context math(context)
snippet `([a-zA-Z])hat` "Auto hat" A
\hat{``rv = m[1]``}
endsnippet

context math(context)
snippet `([a-zA-Z])vec` "Auto vec" A
\vec{``rv = m[1]``}
endsnippet

context math(context)
snippet `([a-zA-Z])dot` "Auto dot" A
\dot{``rv = m[1]``}
endsnippet

context math(context)
snippet `([a-zA-Z])ddot` "Auto ddot" A
\ddot{``rv = m[1]``}
endsnippet

context math(context)
snippet `pa([A-Za-z])([A-Za-z])` "Partial auto" A
\frac{ \partial ``rv = m[1]`` }{ \partial ``rv = m[2]`` } 
endsnippet

context math(context)
snippet `\\bra{([^|]+)\|` "Convert bra to braket" A
\braket{ ``rv = m[1]`` | $1 }$0
endsnippet

